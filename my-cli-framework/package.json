{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/utils/*",
    "packages/models/*",
    "packages/commands/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lerna": "^8.2.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2"
  }
}
